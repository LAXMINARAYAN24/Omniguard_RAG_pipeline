# ==============================================================================
# OmniGuard-RAG Studio Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# NEVER commit .env or real secrets to version control.
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8000

# CORS Security Allowlist (comma-separated origins)
# Explicit trusted origins allowed to access the REST API
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8899,http://localhost:8899

# API Security & Rate Limiting
# Maximum requests per minute per IP address
RATE_LIMIT_PER_MINUTE=120
# Maximum request body size in bytes (1MB default = 1048576)
MAX_CONTENT_LENGTH=1048576

# Local LLM Subsystem Configuration
DEFAULT_LLM_PROVIDER=builtin
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1
# Optional API Key for local/remote OpenAI-compatible provider (leave empty or set placeholder)
OPENAI_COMPAT_API_KEY=

# RAG Defense Parameters
RING0_REPETITION_THRESHOLD=0.50
RING1_VARIANCE_FRACTION=0.40
RING2_COHESION_THRESHOLD=0.55
RING2_CONTENTION_THRESHOLD=0.15
